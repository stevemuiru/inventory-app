<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Categories</title>
    <link rel="stylesheet" href="/styles.css">
</head>
<body>
    <nav>
    <span class="nav-brand">Making Sense Computers</span>
    <ul class="nav-links">
        <li>Dashboard</li>
        <li>Laptops</li>
        <li>Printers</li>
        <li>CCTV Cameras</li>
    </ul>
</nav>
    
   <div class="category-header">
    <h1><%= category[0].name %></h1>
    <a href="/categories/<%= category[0].category_id %>/add" class="add-btn">+ Add Item</a>
</div>

<table class="items-table">
    <thead>
        <tr>
            <th>Name</th>
            <th>Description</th>
            <th>Price</th>
            <th>Quantity</th>
            <th>Action</th>
        </tr>
    </thead>
    <tbody>
        <% category.forEach(item => { %>
        <tr>
            <td><%= item.name %></td>
            <td><%= item.description %></td>
            <td>KSh <%= item.price %></td>
            <td><%= item.quantity %></td>
            <td>
                <form action="/items/<%= item.id %>/delete" method="POST">
                    <button type="submit" class="delete-btn">Delete</button>
                </form>
                <form action="/items/<%= item.id %>/edit" method="POST">
                    <button type="submit" class="edit-btn">Edti</button>
                </form>
            </td>
        </tr>
        <% }) %>
    </tbody>
</table>
</body>
</html>