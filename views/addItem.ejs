<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <link rel="stylesheet" href="/style.css">
    <title>Form</title>
</head>
<body>
    <nav class="navbar">
        <ul class="navlist">
            <li class="subheading">
                <h2>Making Sense Computers</h2>
            </li>
            

            <li class="nav-items">
                <ul class="nav-links">
                    <li class="nav-item">Dashboard</li>
                    <li class="nav-item">Laptops</li>
                    <li class="nav-item">Printers</li>
                    <li class="nav-item">CCtv cameras</li>
                </ul>
            </li>
        </ul>
    </nav>

   <form action="/categories/<%= category_id %>/add" method="POST">

    <div class="form-group">
        <label for="item-name">Item:</label>
        <input type="text" name="name" id="item-name">
    </div>

    <div class="form-group">
        <label for="item-description">Item description:</label>
        <input type="text" name="description" id="item-description">
    </div>
     
    <div class="form-group">
        <label for="item-price">Item price:</label>
        <input type="number" name="price" id="item-price">
    </div>

    <div class="form-group">
        <label for="item-quantity">Item quantity:</label>
        <input type="number" name="quantity" id="item-quantity">
    </div>
  
    <input type="hidden" name="category_id" value="<%= category_id %>"> 
    
    <div class="form-action">
        <button type="submit">Add item</button>
    </div>
   </form> 
</body>
</html>