<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Form</title>
    <link rel="stylesheet" href="/styles.css">
</head>
<body>
    <nav>
    <span class="nav-brand">Making Sense Computers</span>
    <ul class="nav-links">
        <li>Dashboard</li>
        <li>Laptops</li>
        <li>Printers</li>
        <li>CCTV Cameras</li>
    </ul>
</nav>

   <div class="form-container">
    <h2>Add New Item</h2>

    <form action="/categories/<%= category_id %>/add" method="POST">

        <div class="form-group">
            <label for="item-name">Item:</label>
            <input type="text" name="name" id="item-name" required>
        </div>

        <div class="form-group">
            <label for="item-description">Item description:</label>
            <input type="text" name="description" id="item-description" required>
        </div>
         
        <div class="form-group">
            <label for="item-price">Item price:</label>
            <input type="number" name="price" id="item-price" required>
        </div>

        <div class="form-group">
            <label for="item-quantity">Item quantity:</label>
            <input type="number" name="quantity" id="item-quantity" required>
        </div>
      
        <input type="hidden" name="category_id" value="<%= category_id %>"> 
        
        <div class="form-action">
            <button type="submit">Add item</button>
        </div>
    </form>
</div>
</body>
</html>